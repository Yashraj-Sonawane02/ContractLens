# ContractLens Backend Configuration

# Security & JWT Token
SECRET_KEY=contractlens_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; PostgreSQL supported e.g. postgresql://user:pass@localhost:5432/contractlens)
DATABASE_URL=sqlite:///./contractlens.db

# AI Engine Key (Google Gemini API Key - Optional for Statutory Rules, Required for Gemini Chat/Negotiation)
GEMINI_API_KEY=your_gemini_api_key_here

# Encrypted Object Storage (local or s3)
STORAGE_TYPE=local
ENCRYPTION_KEY=32_byte_secret_encryption_key_here_1234

# Error Monitoring (Optional Sentry DSN)
SENTRY_DSN=

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
